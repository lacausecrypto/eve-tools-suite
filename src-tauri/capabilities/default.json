{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacités par défaut de la fenêtre principale.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "global-shortcut:default",
    "clipboard-manager:default",
    "notification:default",
    "updater:default",
    "process:default"
  ]
}
