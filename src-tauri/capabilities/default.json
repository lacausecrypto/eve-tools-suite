{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacités par défaut de la fenêtre principale.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/lacausecrypto/eve-tools-suite"
        },
        {
          "url": "https://github.com/lacausecrypto/eve-tools-suite/**"
        },
        {
          "url": "https://discord.gg/jmPKrr28C5"
        },
        {
          "url": "https://zkillboard.com/**"
        }
      ]
    },
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
