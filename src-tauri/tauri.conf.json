{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVE Tools Suite",
  "version": "0.1.6",
  "identifier": "com.lacausecrypto.evetools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EVE Tools",
        "width": 1320,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost https://images.evetech.net; connect-src 'self' ipc: http://ipc.localhost https://esi.evetech.net https://market.fuzzwork.co.uk https://www.fuzzwork.co.uk https://mutamarket.com https://eu.posthog.com https://*.posthog.com; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["eve-tools-suite"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/lacausecrypto/eve-tools-suite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMUFGQjA3NjhCRkQwNDQKUldSRTBMOW9CL3NhYTQ5N0FSMGZnU1dQZUVDNlpjbUpyQmtyNXdGWDlWQTl0clhSREpmLzdTdXQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
