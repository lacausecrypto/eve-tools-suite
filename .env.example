# Analytics PostHog (auto-hébergé) — OPTIONNEL.
# Copie ce fichier en `.env.local` (non versionné) et renseigne tes valeurs.
# Si l'une des deux variables manque, l'analytics est totalement désactivée
# (aucun chargement de PostHog, aucune requête réseau). La collecte est
# opt-in stricte et anonyme (cf. src/core/analytics).

# Clé « projet » PostHog (publique par conception).
VITE_POSTHOG_KEY=

# URL de ton instance PostHog auto-hébergée (sans slash final).
# Exemple : https://posthog.mondomaine.tld
VITE_POSTHOG_HOST=
